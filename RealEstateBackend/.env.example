PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=realestate_user
DB_PASSWORD=realestate_pass
DB_NAME=realestate
APP_FRONTEND_URL=http://localhost:5173

# OAuth providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/oauth/apple/callback

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@kenreal.local

# Resend email delivery (MVP default)
EMAIL_DELIVERY_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=no-reply@yourdomain.com

# Email verification controls
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
